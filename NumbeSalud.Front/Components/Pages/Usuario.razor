@page "/usuarios"
@using NumbeSalud.Front.Models.Users
@inherits Components

<InsertarUsuario UsuarioCreado="RecargarUsuarios"/>

<EditarUsuario @ref="editarUsuario"
               UsuarioEditado="RecargarUsuarios" />

<Grid TItem="UserResponseDto"
      @ref="userGrid"
      class="table table-bordered border-dark"
      DataProvider="UserData"
      AllowPaging="true"
      AllowFiltering="true"
      Responsive="true">

    <GridColumn TItem="UserResponseDto"
                HeaderText="Nombre"
                PropertyName="Name"
                Filterable="true"
                FilterTextboxWidth="150">
        @context.Name
    </GridColumn>

    <GridColumn TItem="UserResponseDto"
                HeaderText="Apellido"
                PropertyName="LastName"
                Filterable="false">
        @context.LastName
    </GridColumn>

    <GridColumn TItem="UserResponseDto"
                HeaderText="Dirección"
                PropertyName="Address"
                Filterable="false">
        @context.Address
    </GridColumn>

    <GridColumn TItem="UserResponseDto"
                HeaderText="Teléfono"
                PropertyName="Phone"
                Filterable="false">
        @context.Phone
    </GridColumn>

    <GridColumn TItem="UserResponseDto"
                HeaderText="Empresa"
                PropertyName="Company"
                Filterable="true"
                FilterTextboxWidth="150">
        @context.Company
    </GridColumn>
    
    <GridColumn TItem="UserResponseDto"
                HeaderText="Acciones"
                Filterable="false"
                Class="text-center">

        <Button Color="ButtonColor.Warning"
                Size="ButtonSize.Small"
                @onclick="() => EditarUsuario(context.Id)">
            Editar
        </Button>

    </GridColumn>
    
</Grid>
