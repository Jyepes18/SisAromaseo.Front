@using NumbeSalud.Front.DTOs.Product
@using NumbeSalud.Front.DTOs.User
@inherits Components


<div class="d-flex justify-content-between align-items-center pb-4 pt-1">
    <div class="d-flex align-items-center gap-2">

        <span class="badge text-bg-success rounded-pill px-3 py-2">
            Más de 3 días
        </span>

        <span class="badge text-bg-warning rounded-pill px-3 py-2">
            Faltan 1 - 3 días
        </span>

        <span class="badge text-bg-danger rounded-pill px-3 py-2">
            Vencida / Hoy
        </span>

        <span class="badge text-bg-secondary rounded-pill px-3 py-2">
            Ya fue entregado
        </span>

    </div>
    
    <button type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#nuevaProgramacionModal">
        Insertar Programacion
    </button>

</div>

<div class="modal fade" id="nuevaProgramacionModal" tabindex="-1" aria-labelledby="NuevaProgramacion" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="NuevaProgramacion">Insertar nueva Progrmacion</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <EditForm Model="@newOrder" OnValidSubmit="InsertOrder">
                <DataAnnotationsValidator/> <ValidationSummary/>
                <div class="modal-body">
                    <div class="alert alert-primary" role="alert">
                        Todos los campos con un * son obligatorios
                    </div>
                    
                    <div class="mb-3">
                        <label for="name" class="form-label">Cliente (*)</label>

                        <AutoComplete @bind-Value="clienteName"
                                      TItem="UserList"
                                      DataProvider="UserDataProvider"
                                      PropertyName="DisplayName"
                                      Placeholder="Buscar cliente..."
                                      OnChanged="(UserList cliente) => OnAutoCompleteChanged(cliente)" />
                    </div>
                    
                    <div class="mb-3">
                        <label for="date" class="form-label">Fecha de entrega (*)</label>
                        <DateInput TValue="DateTime" @bind-Value="newOrder.Date" class="form-control border border-secondary" id="date" Placeholder="Fecha Entrega"/>
                        <ValidationMessage For="@(() => newOrder.Date)" />
                    </div>
                    
                    
                    <div class="mb-3">
                        <label class="form-label">Producto (*)</label>

                        <AutoComplete @bind-Value="productoName"
                                      TItem="ProductList"
                                      DataProvider="ProductDataProvider"
                                      PropertyName="Name"
                                      Placeholder="Buscar producto..."
                                      OnChanged="OnProductChanged" />
                    </div>
                        @if (orderDetails.Any())
                        {
                            <div class="mt-4">
                                <h5>Detalle de la orden</h5>

                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Producto</th>
                                                <th>Precio unitario</th>
                                                <th style="width: 130px;">Cantidad</th>
                                                <th>Subtotal</th>
                                                <th></th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var detail in orderDetails)
                                            {
                                                <tr @key="detail.ProductId">
                                                    <td>@detail.ProductName</td>

                                                    <td>
                                                        @detail.UnitPrice.ToString("C")
                                                    </td>

                                                    <td>
                                                        <InputNumber TValue="int"
                                                                     class="form-control"
                                                                     min="1"
                                                                     @bind-Value="detail.Quantity" />
                                                    </td>

                                                    <td>
                                                        <strong>
                                                            @detail.Subtotal.ToString("C")
                                                        </strong>
                                                    </td>

                                                    <td>
                                                        <button type="button"
                                                                class="btn btn-outline-danger btn-sm"
                                                                @onclick="() => RemoveProduct(detail)">
                                                            Eliminar
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>

                                        <tfoot>
                                            <tr>
                                                <th colspan="3" class="text-end">
                                                    Total:
                                                </th>

                                                <th>
                                                    <strong>@TotalOrder.ToString("C")</strong>
                                                </th>

                                                <th></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-primary">Insertar</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>