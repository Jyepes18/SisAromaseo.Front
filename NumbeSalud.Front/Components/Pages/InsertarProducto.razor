@inherits Components

<div class="d-flex justify-content-end pb-4 pt-1">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#nuevoUsuarioModal">
        Insertar Producto
    </button>
</div>


<div class="modal fade" id="nuevoUsuarioModal" tabindex="-1" aria-labelledby="nuevoUsuario" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="nuevoUsuario">Insertar nuevo usuario</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <EditForm Model="@newProducto" OnValidSubmit="InsertProduct">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="modal-body">

                    <div class="alert alert-primary" role="alert">
                        Todos los campos con un * son obligatorios
                    </div>

                    <div class="mb-3">
                        <label for="name" class="form-label">Nombre (*)</label>
                        <TextInput @bind-Value="newProducto.Name" class="form-control border border-secondary" id="name" />
                        <ValidationMessage For="@(() => newProducto.Name)" />
                    </div>

                    <div class="mb-3">
                        <label for="presentation" class="form-label">Presentación (*)</label>
                        <TextInput @bind-Value="newProducto.Presentation" class="form-control border border-secondary" id="presentation" />
                        <ValidationMessage For="@(() => newProducto.Presentation)" />
                    </div>

                    <div class="mb-3">
                        <label for="price" class="form-label">Precio (*)</label>
                        <InputNumber @bind-Value="newProducto.Price" class="form-control border border-secondary" id="price" />
                        <ValidationMessage For="@(() => newProducto.Price)" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-primary">Insertar</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>