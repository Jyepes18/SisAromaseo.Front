@page "/Error"
@layout EmptyLayout

<div class="container">
    <div class="d-flex flex-column justify-content-center align-items-center text-center vh-100">

        <Image Src="/IMGs/Error404.svg" Alt="Error 404" Class="img-fluid" Style="max-width: 350px; width: 100%;" />

        <h2 class="mt-4 fw-bold">¡Tenemos un error!</h2>
        <p class="text-secondary mt-2" style="max-width: 420px;">
            Lo sentimos, algo salió mal. Por favor, comunícate con nuestro equipo de soporte
            para que podamos ayudarte.
        </p>
    </div>
</div>