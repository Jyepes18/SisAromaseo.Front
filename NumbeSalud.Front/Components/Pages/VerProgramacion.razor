@inherits Components

<div class="modal fade"
     id="verProgramacionModal"
     tabindex="-1"
     aria-labelledby="verProgramacionModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="verProgramacionModalLabel">
                        Detalle de la programación
                    </h5>

                    @if (viewOrder is not null)
                    {
                        <small class="text-muted">
                            Pedido #@viewOrder.Id
                        </small>
                    }
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>
            </div>
            
            <div class="modal-body">

                @if (viewOrder is not null)
                {
                    <!-- INFORMACIÓN GENERAL -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="bi bi-info-circle me-2"></i>
                                Información del pedido
                            </h6>
                        </div>

                        <div class="card-body">

                            <div class="row g-3">

                                <!-- CLIENTE -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Cliente
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           value="@viewOrder.FullName"
                                           readonly />
                                </div>

                                <!-- ESTADO -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Estado
                                    </label>

                                    <div>
                                        @if (viewOrder.Status == "PROGRAMMING")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2">
                                                Programado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2">
                                                @viewOrder.Status
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- FECHA -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Fecha de entrega
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           value="@viewOrder.Date.ToString("dd/MM/yyyy")"
                                           readonly />
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- PRODUCTOS -->
                    <div class="card border-0 shadow-sm">

                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="bi bi-box-seam me-2"></i>
                                Productos
                            </h6>
                        </div>

                        <div class="card-body p-0">

                            <div class="table-responsive">

                                <table class="table table-hover align-middle mb-0">

                                    <thead class="table-light">
                                        <tr>
                                            <th>
                                                Producto
                                            </th>

                                            <th class="text-center">
                                                Cantidad
                                            </th>

                                            <th class="text-end">
                                                Precio
                                            </th>

                                            <th class="text-end">
                                                Subtotal
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @if (viewOrder.DetailOrderResponseDtos is not null &&
                                             viewOrder.DetailOrderResponseDtos.Any())
                                        {
                                            @foreach (var detail in viewOrder.DetailOrderResponseDtos)
                                            {
                                                <tr>

                                                    <td>
                                                        <span class="fw-semibold">
                                                            @detail.ProductName
                                                        </span>
                                                    </td>

                                                    <td class="text-center">
                                                        @detail.Quantity
                                                    </td>

                                                    <td class="text-end">
                                                        @detail.Price.ToString("C0")
                                                    </td>

                                                    <td class="text-end">
                                                        @detail.SubTotal.ToString("C0")
                                                    </td>

                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4"
                                                    class="text-center text-muted py-4">
                                                    No hay productos registrados.
                                                </td>
                                            </tr>
                                        }

                                    </tbody>

                                    <!-- TOTAL -->
                                    <tfoot>

                                        <tr>
                                            <td colspan="3"
                                                class="text-end fw-bold">
                                                Total
                                            </td>

                                            <td class="text-end fw-bold fs-5">
                                                @viewOrder.Total.ToString("C0")
                                            </td>
                                        </tr>

                                    </tfoot>

                                </table>

                            </div>

                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"
                             role="status">
                        </div>

                        <p class="mt-3 text-muted">
                            Cargando información...
                        </p>
                    </div>
                }

            </div>
            
            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

            </div>

        </div>
    </div>
</div>